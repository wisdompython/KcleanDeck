# Settings for the throwaway end-to-end test stack. Not secrets: this stack
# only ever runs locally or in CI with a fresh database.

SITE_ADDRESS=:80
HTTP_PORT=8089
HTTPS_PORT=8449
FRONTEND_URL=http://localhost:8089

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=e2e-only-not-secret-8f3b2a91c7d64e5f
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8089
DJANGO_SECURE_COOKIES=0
DJANGO_ADMIN_PATH=backstage
DJANGO_DISABLE_THROTTLES=1

# First owner account the tests sign in with.
DJANGO_SUPERUSER_USERNAME=owner
DJANGO_SUPERUSER_EMAIL=owner@e2e.kleandeck.test
DJANGO_SUPERUSER_PASSWORD=E2e-owner-pass-1

POSTGRES_DB=kleandeck
POSTGRES_USER=kleandeck
POSTGRES_PASSWORD=e2epassword123

PAYSTACK_SECRET_KEY=sk_test_e2e

# Used by compose.yml to load this file into the backend (paths from the repo root).
ENV_FILE=e2e/e2e.env
