# Copy to .env and fill in. Docker Compose and local `manage.py` both read this file.

# --- Public URL ---------------------------------------------------------------
# Domain Caddy serves (it gets an HTTPS certificate automatically for a real
# domain). Use :80 to serve plain HTTP on any host, e.g. for local Docker runs.
SITE_ADDRESS=:80
# Full public URL of the website; Paystack redirects customers back here.
FRONTEND_URL=http://localhost

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Path of the backup Django admin (superusers only). The team admin is /admin.
DJANGO_ADMIN_PATH=backstage
# Set to 0 only when serving the admin over plain HTTP (local Docker runs).
DJANGO_SECURE_COOKIES=0

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=kleandeck
POSTGRES_USER=kleandeck
POSTGRES_PASSWORD=change-me
# Leave unset locally to use SQLite. Compose builds its own URL for the container.
# DATABASE_URL=postgresql://kleandeck:change-me@localhost:5432/kleandeck

# --- Paystack -----------------------------------------------------------------
# Test keys (sk_test_...) until launch. The webhook URL to set in the Paystack
# dashboard is  <FRONTEND_URL>/api/paystack/webhook/
PAYSTACK_SECRET_KEY=

# --- Email (optional; prints to the backend log when unset) -------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Kleandeck <no-reply@kleandeck.com>

# --- Frontend -----------------------------------------------------------------
# How the Next.js server reaches Django (server-side rendering).
BACKEND_INTERNAL_URL=http://localhost:8000
