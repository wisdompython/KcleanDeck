# One public entry point. Django serves the API, its static files and the
# backup Django admin (DJANGO_ADMIN_PATH, default "backstage"); Next.js serves
# everything else, including the team admin at /admin.
#
# SITE_ADDRESS=:80              plain HTTP on any host (local Docker runs)
# SITE_ADDRESS=kleandeck.com    automatic HTTPS via Let's Encrypt (point DNS here first)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@django path /api/* /{$DJANGO_ADMIN_PATH:backstage} /{$DJANGO_ADMIN_PATH:backstage}/* /static/* /healthz
	# Uploaded photos, served straight from the shared volume. Filenames are
	# random and never reused, so browsers can cache them for a long time.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
